# Copy this file to backend/.env and fill in the values.
# Never commit backend/.env.

# --- Database ---
# Leave empty to use a local SQLite file (backend/reqguard.db).
# Supabase example: postgresql+psycopg://postgres:<password>@db.<project>.supabase.co:5432/postgres
DATABASE_URL=

# --- LLM ---
# LLM_PROVIDER: anthropic | openai | gemini
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=

# --- Jira Cloud ---
# e.g. https://your-site.atlassian.net
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=

# --- Slack (bot token, scopes: channels:history, channels:read) ---
SLACK_BOT_TOKEN=

# --- Telegram (bot from @BotFather, privacy mode off) ---
TELEGRAM_BOT_TOKEN=

# --- Discord (bot with Message Content intent) ---
DISCORD_BOT_TOKEN=

# --- Gmail (Google Cloud OAuth client, test mode) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- GitHub (repo read, PR comment) ---
GITHUB_TOKEN=

# --- Frontend origins allowed to call the API (comma-separated) ---
CORS_ORIGINS=http://localhost:3000
